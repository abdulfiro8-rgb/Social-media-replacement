# Vorlage fuer den OMV-Compose "Environment"-Block des Stacks "immich".
# KEINE echten Passwoerter in dieses Repo committen.

# Ablage der Original-Medien (OMV Shared Folder "nascld")
UPLOAD_LOCATION=/srv/dev-disk-by-uuid-b3ea1171-e620-4617-90b2-c30ead200312/nascld/Immich

# Postgres-Datenverzeichnis.
# Empfehlung: NICHT innerhalb von UPLOAD_LOCATION, sondern daneben.
# Immich mountet UPLOAD_LOCATION als /data und verwaltet diesen Baum selbst.
DB_DATA_LOCATION=/srv/dev-disk-by-uuid-b3ea1171-e620-4617-90b2-c30ead200312/nascld/immich-db

TZ=Europe/Berlin
IMMICH_VERSION=v3

# Nur A-Za-z0-9 verwenden. Keine Sonderzeichen, keine Leerzeichen,
# keine Anfuehrungszeichen und kein Inline-Kommentar hinter dem Wert:
# "$" bricht die Compose-Substitution, " #" wird als Kommentar abgeschnitten.
DB_PASSWORD=BitteHierEigenesAlphanumerischesPasswort

# Die Werte darunter muessen nicht geaendert werden
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
